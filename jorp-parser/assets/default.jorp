slide-container id="slide-container" style="width:100vw; height:40.25vw;";

div id="canvas-container";

div id="blue-bg";

div id="title-image" {
  img src="./assets/images/title-img.png";
  div id="title-text-container" {
    &h1 class+="top-margin" : Cassini-Huygens;
    &h2 : Exploring Saturn and its Moons;
  }
  div id="title-text-container-reverse" {
    &h3 class+="bottom-margin" : by Joseph and Ranfateh;
  }
}

horizontal-flex *,** id="outline" {
  0 div id="outline-container" {
    &h3 class+="big bottom-margin" : Outline;
    &p class+="big bottom-margin" : - Cassini-Huygens Overview;
    &p class+="big bottom-margin" : - History and Planning;
    &p class+="big bottom-margin" : - The Saturnian System and Mission Goals;
    &p class+="big bottom-margin" : - Spacecraft Instruments;
    &p class+="big bottom-margin" : - Mission Timeline;
    &p class+="big bottom-margin" : - Summary/Key Discoveries;
    &p class+="big bottom-margin" : - Sources;
  }
  1 img src="./assets/images/cassini-drawing.jpg";
}

div id="overview" {
  div id="overview-container" {
    &h3 class+="big bottom-margin" : Overview - Cassini-Huygens;
    &p class+="big bottom-margin" : - Cassini-Huygens was a research mission conducted jointly by NASA, the ESA, and the ASI.;
    &p class+="big bottom-margin" : - Consisted of an orbiter (Cassini) and a landing craft (Huygens) sent to explore Saturn's system 
    (in particular, the moon of Titan).;
    &p class+="big bottom-margin" : - Began in October 1997 and ended in September of 2017.;
  }
  div class+="image-set space-around" {
    &img src="./assets/images/nasa.png" style="max-width: 25rem; max-height: 15rem;";
    &img src="./assets/images/esa.png" style="max-width: 30rem; max-height: 15rem;";
    &img src="./assets/images/asi.png" style="max-width: 25rem; max-height: 15rem;";
  }
}

div/history {
  !div class+="history-description-box" {
    horizontal-flex *****,** {
      0 div {
        &h3 class+="big bottom-margin" : CASSINI - NAMESAKE;
        &p class+="big bottom-margin" : Italian-French astronomer (1625 - 1712).;
        &p class+="big bottom-margin" : Credited with discovering:;
        &p class+="big bottom-margin" : - Four moons of Saturn (Iapetus, Rhea, Tethys, and Dione);
        &p class+="big bottom-margin" : - A gap in Saturn's rings (Cassini division);
        &p class+="big bottom-margin" : - The Great Red Spot on Jupiter along with Robert Hooke;
        &p class+="big bottom-margin" : - Rotational periods of Mars and Jupiter;
        &p class+="big bottom-margin" : Also made a topographic map of France.;
      }
    }
    div class+="image-set-vertical-reverse" {
      &img src="./assets/images/cassini.jpg" style="max-width: 30rem; max-height: 40rem;";
    }
  }
  !div class+="history-description-box" {
    horizontal-flex *****,** {
      0 div {
        &h3 class+="big bottom-margin" : HUYGENS - NAMESAKE;
        &p class+="big bottom-margin" : Dutch polymath (1629 - 1695);
        &p class+="big bottom-margin" : Studied Saturn and in particular its rings.;
        &p class+="big bottom-margin" : First to correctly describe the structure of Saturn's rings.;
        &p class+="big bottom-margin" : Discovered Saturn's largest moon, Titan.;
        &p class+="big bottom-margin" : Improved telescope designs.;
        &p class+="big bottom-margin" : Invented the pendulum clock.;
      }
    }
    div class+="image-set" {
      &img src="./assets/images/aspects-of-saturn.jpg" style="max-width: 20rem; max-height: 30rem;";
      &img src="./assets/images/huygens.jpg" style="max-width: 20rem; max-height: 30rem;";
    }
  }
  !div class+="history-description-box" {
    horizontal-flex *****,** {
      0 div {
        &h3 class+="big bottom-margin" : MISSION ORIGINS;
        &p class+="big bottom-margin" : - Flybys of Saturn had been conducted on 1979, 1980, and 1981 by
Pioneer 11, Voyager 1, and Voyager 2 respectively.;
        &p class+="big bottom-margin" : - A mission dedicated to Saturn was first proposed in July 1982 by members of the European Space Agency.;
        &p class+="big bottom-margin" : - Around the same time NASA was looking for more affordable missions.;
      }
    }
    div class+="image-set" {
      &img src="./assets/images/saturn-voyager2.jpg" style="max-width: 25rem; max-height: 30rem;";
      &img src="./assets/images/saturn-voyager1.jpg" style="max-width: 25rem; max-height: 20rem;";
      &img src="./assets/images/saturn-pioneer11.jpg" style="max-width: 25rem; max-height: 20rem;";
    }
  }
  !div class+="history-description-box" {
    horizontal-flex ****,*** {
      0 div {
        &h3 class+="big bottom-margin" : MISSION PLANNING (1982 - 1997);
        &p class+="big bottom-margin" : - The Planetary Observer program and Mariner Mark II program were proposed by NASA.;
        &p class+="big bottom-margin" : - One of the major missions of Mariner Mark II would be the Saturn Orbiter/Titan Probe (SOTP).;
        &p class+="big bottom-margin" : - From 1984-1985 a joint study was conducted by NASA and the ESA on SOTP.;
      }
    }
    div class+="image-set-vertical-reverse" {
      &img src="./assets/images/mariner-mk2.jpg" style="max-width: 30rem; max-height: 40rem;";
    }
  }
  !div class+="history-description-box" {
    horizontal-flex ****,*** {
      0 div {
        &h3 class+="big bottom-margin" : CONSTRUCTION;
        &p class+="big bottom-margin" : - Construction on the Huygens probe began as early as 1989.;
        &p class+="big bottom-margin" : - NASA received approval for the SOTP mission (now named Cassini-Huygens) in 1990.;
        &p class+="big bottom-margin" : - Budget cuts killed the rest of the Mariner MkII program making Cassini much more specialized.;
        &p class+="big bottom-margin" : - Construction of Cassini began in 1995 with collaboration from both NASA and the ESA.;
        &p class+="big bottom-margin" : - ~17 countries contributed to its assembly.; 
        &p class+="big bottom-margin" : - Ready to launch by July 1997.;
      }
    }
    div class+="image-set" {
      &img src="./assets/images/cassini-construction.jpg" style="max-width: 20rem; max-height: 30rem;";
      &img src="./assets/images/huygens-construction.jpg" style="max-width: 20rem; max-height: 30rem;";
    }
  }
}

div/saturn-system {
  !div class+="saturn-description-box" {
    horizontal-flex *****,** {
      0 div {
        &h3 class+="big bottom-margin" : SATURN;
        &p class+="big bottom-margin" : - Second largest planet and sixth from the Sun.;
        &p class+="big bottom-margin" : - Contains a very extensive ring structure.;
        &p class+="big bottom-margin" : - Most moons of any planet.;
        &p class+="big bottom-margin" : - 7 major moons.;
        &p class+="big bottom-margin" : - Axial tilt of 26.73 degrees.;
        !&div {
          &hr style="width:45rem; margin-left:0;" class+="bottom-margin";
          &h3 class+="big bottom-margin" : Cassini-Huygens' Goals;
          &p class+="big bottom-margin" : Investigate Saturn's:;
          &p class+="big bottom-margin" : - Magnetosphere.;
          &p class+="big bottom-margin" : - Internal and atmospheric composition.;
          &p class+="big bottom-margin" : - Various atmospheric properties.;
          &p class+="big bottom-margin" : - Rotational period.;
        }
      }
    }
    div class+="image-set-vertical-reverse" {
      &img src="./assets/images/g-saturn-1.jpg" style="max-width: 40rem; max-height: 20rem;";
      &img src="./assets/images/g-saturn-2.jpg" style="max-width: 40rem; max-height: 20rem;";
    }
  }
  !div class+="saturn-description-box" {
    horizontal-flex *****,** {
      0 div {
        &h3 class+="big bottom-margin" : RINGS;
        &p class+="big bottom-margin" : - Consists of many distinct bands and divisions.;
        &p class+="big bottom-margin" : - A, B, and C-rings are the largest and most visible.;
        !&horizontal-flex *,* {
          0 div {
            &hr style="width:45rem; margin-left:0;" class+="bottom-margin";
            &h3 class+="big bottom-margin" : Cassini-Huygens' Goals;
            &p class+="big bottom-margin" : - Investigate how light interacts with the ring system.;
            &p class+="big bottom-margin" : - Measure the mass of the rings.;
            &p class+="big bottom-margin" : - Determine the processes responsible for the ring's structure.;
            &p class+="big bottom-margin" : - Analyze an environment similar to that of the early Solar System.;
          }
        }
      }
    }
    div class+="image-set" {
      &img src="./assets/images/rings.jpg" style="max-width: 50rem; max-height: 30rem;";
    }
  }
  !div class+="saturn-description-box" {
    horizontal-flex *****,** {
      0 div {
        &h3 class+="big bottom-margin" : TITAN;
        &p class+="big bottom-margin" : - Second largest moon in the Solar System.;
        &p class+="big bottom-margin" : - Only moon to have a permanent atmosphere.;
        !&div {
          &hr style="width:45rem; margin-left:0;" class+="bottom-margin";
          &h3 class+="big bottom-margin" : Cassini-Huygens' Goals;
          &p class+="big bottom-margin" : - Land the Huygens Probe on Titan.;
          &p class+="big bottom-margin" : - Find out what's under Titan's atmosphere.;
          &p class+="big bottom-margin" : - Investigate magnetosphere and composition.;
        }
      }
    }
    div class+="image-set-vertical-reverse" {
      &img src="./assets/images/g-titan-1.jpg" style="max-width: 30rem; max-height: 40rem;";
    }
  }
  !div class+="saturn-description-box" {
    horizontal-flex *****,** {
      0 div {
        &h3 class+="big bottom-margin" : OTHER MAJOR MOONS;
        &p class+="big bottom-margin" : - Rhea;
        &p class+="big bottom-margin" : - Iapetus;
        &p class+="big bottom-margin" : - Dione;
        &p class+="big bottom-margin" : - Tethys;
        &p class+="big bottom-margin" : - Enceladus;
        &p class+="big bottom-margin" : - Mimas;
        !&div {
          &hr style="width:45rem; margin-left:0;" class+="bottom-margin";
          &h3 class+="big bottom-margin" : Cassini-Huygens' Goals;
          &p class+="big bottom-margin" : - Investigate magnetosphere and composition.;
          &p class+="big bottom-margin" : - Map surface geographic features.;
          &p class+="big bottom-margin" : - Determine the presence of active geological processes.;
        }
      }
    }
    div class+="image-set-vertical-reverse" {
      &img src="./assets/images/saturn-moons.jpg" style="max-width: 50rem; max-height: 40rem;";
    }
  }
  !div class+="saturn-description-box" {
    horizontal-flex *****,** {
      0 div {
        &h3 class+="big bottom-margin" : MINOR MOONS;
        &p class+="big bottom-margin" : - Mostly consisting of irregular moons.;
        &p class+="big bottom-margin" : - Split into the Inuit, Gallic, and Norse groups based on the properties of their orbits.;
        !&div {
          &hr style="width:45rem; margin-left:0;" class+="bottom-margin";
          &h3 class+="big bottom-margin" : Cassini-Huygens' Goals;
          &p class+="big bottom-margin" : - Investigate the interaction between Saturn's moons and its ring system.;
        }
      }
    }
    div class+="image-set-vertical" {
      &img src="./assets/images/minor-moons.jpg" style="max-width: 40rem; max-height: 30rem;";
    }
  }
}

div id="summary-container" {
  horizontal-flex *,* {
    0 div class+="padded-div" {
      &div/key-discoveries class+="summary-description-box" {
        &h3 class+="bottom-margin" : KEY DISCOVERIES;
        !&p class+="bottom-margin" : - Large amount of information gathered on the composition of Saturn, its rings, and its moons.;
        !&p class+="bottom-margin" : - Data gathered on the magnetic fields of Saturn and its moons;
        !&p class+="bottom-margin" : - Better understanding on the structure and formation of Saturn's rings.;
        !&p class+="bottom-margin" : - Titan's surface revealed to be geologically active and similar to Earth.;
        !&p class+="bottom-margin" : - Icy plumes on Enceladus and a subsurface ocean which may contain life.;
        !&p class+="bottom-margin" : - Surfaced mapped for Saturn's major moons.;
        !&p class+="bottom-margin" : - Data gathered on the Saturn's weather and its short-term and long-term changes.;
        !&p class+="bottom-margin" : - Over 395,000 new images captured.;
      }
    }
    1 div class+="image-set-vertical" {
      &img src="./assets/images/titan-surface-map.jpg" style="max-width: 35rem; max-height: 25rem;";
      &img src="./assets/images/enceladus-plumes.jpg" style="max-width: 35rem; max-height: 25rem;";
    }
  }
}

div/instruments {
  !horizontal-flex *,** {
    0 div class+="padded-div" {
      &div class+="instrument-description-box" {
        &h3 : HUYGENS PROBE;
        &h4 class+="bottom-margin" : A probe designed to perform a surface-landing on the moon of Titan.;
        &hr class+="bottom-margin";
        &p class+="bottom-margin" : HASI - Huygens Atmospheric Structure Instrument.;
        &p class+="bottom-margin" : DWE - Doppler Wind Instrument.;
        &p class+="bottom-margin" : DISR - Descent Imager/Spectral Radiometer.;
        &p class+="bottom-margin" : ACP - Aerosol Collector and Pyrolyzer.;
        &p class+="bottom-margin" : GCMS - Gas Chromatograph Mass Spectrometer.;
        &p class+="bottom-margin" : SSP - Surface-Science Package.;
      }
    }
  }
  !horizontal-flex *,** {
    0 div class+="padded-div" {
      &div class+="instrument-description-box" { 
        &h3 : ANTENNAE;
        &h4 class+="bottom-margin" : Instruments used to transmit data between the Earth and the spacecraft.;
        &hr class+="bottom-margin";
        &p class+="bottom-margin" : - 1 High-gain antenna with a 4 meter diameter dish.;
        &p class+="bottom-margin" : - 2 Low-gain antennae.;
        &p class+="bottom-margin" : - Saturn's distance to Earth varies from 1.2-1.6 billion kilometers.;
        &p class+="bottom-margin" : - Estimated peak data transfer rate of 364.8kbps (kilobits per second);
      }
    }
  }
  !horizontal-flex *,** {
    0 div class+="padded-div" {
      &div class+="instrument-description-box" { 
        &h3 : RADIOISOTOPE THERMOELECTRIC GENERATORS (RTGs);
        &h4 class+="bottom-margin" : An electric generator which produces energy via radioactive decay of material.;
        &hr class+="bottom-margin";
        &p class+="bottom-margin" : - Preferred over solar panels due to the scarcity of sunlight.;
        &p class+="bottom-margin" : - Used in conjunction with radioisotope heater units (RHUs) to regulate temperature.;
        &p class+="bottom-margin" : - Plutonium-238 fuel.;
      }
    }
  }
  !horizontal-flex *,** {
    0 div class+="padded-div" {
      &div class+="instrument-description-box" { 
        &h3 : SPECTROMETERS;
        &h4 class+="bottom-margin" : Devices which analyze light and particles primarily to study the temperature and composition of Saturn.;
        &hr class+="bottom-margin";
        &p class+="bottom-margin" : - CAPS - Cassini Plasma Spectrometer;
        &p class+="bottom-margin" : - INMS - Ion and Neutral Mass Spectrometer;
        &hr class+="bottom-margin";
        &p class+="bottom-margin" : - UVIS - Ultraviolet Imaging Spectrograph;
        &p class+="bottom-margin" : - ISS - Imaging Science Subsystem;
        &p class+="bottom-margin" : - VIMS - Visible and Infrared Mapping Spectrometer;
        &p class+="bottom-margin" : - CIRS - Composite Infrared Spectrometer;
      }
    }
  }
  !horizontal-flex *,** {
    0 div class+="padded-div" {
      &div class+="instrument-description-box" {
        &h3 : MAGNETOMETER;
        &h4 class+="bottom-margin" : A device to measure strength and direction of a magnetic field.;
        &hr class+="bottom-margin";
        &p class+="bottom-margin" : - Used to study the magnetosphere of Saturn.;
        &p class+="bottom-margin" : - "Very sophisticated magnetic compass.";
        &p class+="bottom-margin" : - Provides context for data collected by other instruments.;
      }
    }
  }
}

horizontal-flex *,** id="date-tab" {
  0 div class+="padded-div" {
    &div class+="date-information-box" {
      &p id="date" class+="date-element bottom-margin" : June 11 2004;
      &p id="day-count" class+="date-element bottom-margin" : Days since launch: 0;
    }
  }
}

horizontal-flex/timeline ****,*** id="timeline-tab" {
  1 div class+="timeline-event-information-box" {
    !div {
      &h3 class+="bottom-margin" : Liftoff;
      &p class+="bottom-margin" : - Oct 15 1997 4:43am EDT at Cape Canaveral.;
      &p class+="bottom-margin" : - Launched using a Titan IV-B heavy-lift launch vehicle (HLV).;
      &hr class+="bottom-margin";
      &h3 class+="bottom-margin" : Staging;
      &p class+="bottom-margin" : - Stage 0 - Two radially-mounted solid-rocket boosters.;
      &p class+="bottom-margin" : - Stage 1 - One LR87 liquid-propellant booster.;
      &p class+="bottom-margin" : - Stage 2 - One LR91 liquid-propellant booster.;
      &p class+="bottom-margin" : - Centaur T upper-stage.;
    }
    !div {
      &h3 class+="bottom-margin" : Venus Flyby and Gravity-Assist #1;
      &hr class+="bottom-margin";
      &h3 class+="bottom-margin" : Gravity Assist;
      &p class+="bottom-margin" : - Orbital maneuver which uses gravity to redirect an object's trajectory.;
      &p class+="bottom-margin" : - Kinetic energy gained/lossed for one object is lossed/gained for the other.;
      &hr class+="bottom-margin";
      &p class+="bottom-margin" : Closest approach of around 280km.;
      &p class+="bottom-margin" : - First of many gravity assists performed by Cassini-Huygens.;
    }
    !div {
      &h3 class+="bottom-margin" : Venus Flyby and Gravity-Assist #2;
      &p class+="bottom-margin" : Dec 3 1998 - DSM-1 (deep space maneuver) performed in order to reach this trajectory.;
      &p class+="bottom-margin" : Closest approach of around 630km.;
    }
    !div {
      &h3 class+="bottom-margin" : Earth-Moon Flyby and Gravity-Assist;
      &p class+="bottom-margin" : Closest approach to the Moon at around 377,000km.;
      &p class+="bottom-margin" : Closest approach to the Earth at around 1200km.;
    }
    !div {
      &h3 class+="bottom-margin" : Jupiter Flyby and Gravity-Assist;
      &p class+="bottom-margin" : Closest approach of around 10,000,000km.;
    }
    !div {
      &h3 : Encounter with Saturn;
    }

    !div {
      &h3 class+="bottom-margin" : Approach with Phoebe;
      &p class+="bottom-margin" : - First major science conducted around Saturn.;
      &p class+="bottom-margin" : - Largest of Saturn's irregular moons.;
    }
    !div {
      &h3 : First perichron;
      &p class+="bottom-margin" : Happy Canada Day!;
      &p class+="bottom-margin" : - 1.5 hour burn to capture into Saturn's orbit (orbital insertion).;
      &p class+="bottom-margin" : - Closest point to Saturn in an orbit. (periapsis);
    }
    !div {
      &h3 class+="bottom-margin" : Discovery of Methone and Pallene;
      &p class+="bottom-margin" : - Originally designated S/2004 S1 and S/2004 S2.;
      &p class+="bottom-margin" : - First of seven moons which would be discovered by Cassini-Huygens.;
    }
    !div {
      &h3 class+="bottom-margin" : First Titan Close-Proximity Flyby and Gravity-Assist;
      &p class+="bottom-margin" : - Geographic similarities to Earth.;
      &p class+="bottom-margin" : - Geologically active.;
      &p class+="bottom-margin" : - Presence of dunes and erosion channels.;
    }
    !div {
      &h3 : Huygens Probe is Released;
      &p class+="bottom-margin" : Merry Christmas!;
      &p class+="bottom-margin" : Set on a 21-day trajectory to Titan.;
    }
    !div {
      &h3 class+="bottom-margin" : Huygens Lands on Titan;
      &p class+="bottom-margin" : - First and only man-made object to have succesfully landed on a body in the outer Solar System.;
      &p class+="bottom-margin" : - Atmosphere consists mostly of nitrogen (95%) and methane (5%).;
      &p class+="bottom-margin" : - Methane undergoes a process similar to Earth's water cycle.;
    }
    !div {
      &h3 class+="bottom-margin" : First Enceladus Close-Proximity Flyby;
      &p class+="bottom-margin" : - Observations of Enceladus' magnetic field showed evidence of a thin atmosphere.;
      &p class+="bottom-margin" : - Discovery of warmer fractures in the crust called "tiger stripes.";
      &p class+="bottom-margin" : - Data taken next year revealed large geysers that launched water vapour and other gases into outer space.;
      &p class+="bottom-margin" : - Material ejected from Enceladus is believed to have formed Saturn's E-ring.;
      &p class+="bottom-margin" : - Data later confirmed to indicate the existence of a large subsurface ocean.;
    }
    !div {
      &h3 class+="bottom-margin" : Initial Mission Phase Summary;
      &hr class+="bottom-margin";
      &h3 : New Moons Discovered;
      &p : - June 1 2004 - Methone;
      &p : - June 1 2004 - Pallene;
      &p : - Oct 21 2004 - Polydeuces;
      &p : - May 01 2005 - Daphnis;
      &p class+="bottom-margin" : - May 30 2007 - Anthe;
      &hr class+="bottom-margin";
      &h3 : Flybys;
      &p : Titan - 44;
      &p : Enceladus - 4;
      &p : Tethys - 2;
      &p : Methone - 2;
      &p : Polydeuces - 1;
      &p : Hyperion - 1;
      &p : Phoebe - 1;
      &p : Dione - 1;
      &p : Rhea - 1;
      &p : Iapetus - 1;
      &p class+="bottom-margin" : Janus - 1;
      &h3 : Total - 59;
    }
    !div {
      &h3 class+="bottom-margin" : Cassini Equinox Mission (Jul 2008 - Sep 2010);
    }
    !div {
      &h3 class+="bottom-margin" : Cassini Equinox Mission Summary;
      &hr class+="bottom-margin";
      &h3 : New Moons Discovered;
      &p : - Feb 03 2009 - Aegeaon;   
      &p class+="bottom-margin" : - Nov 02 2009 - S/2009 S 1;
      &hr class+="bottom-margin";
      &h3 : Flybys;
      &p : Titan - 25;
      &p : Enceladus - 8;
      &p : Palene - 1;
      &p : Calypso - 1;
      &p : Mimas - 1;
      &p : Rhea - 1;
      &p : Helene - 1;
      &p class+="bottom-margin" : Dione - 1;
      &h3 : Total - 39;
    }
    !div {
      &h3 class+="bottom-margin" : Cassini Solstice Mission (Sep 2010 - Sep 15 2017);
    }
    !div {
      &h3 class+="bottom-margin" : Great White Spot (2010 - 2011);
      &p : - Large storm on Saturn which periodically appears every ~30 years.;
      &p : - Occurs during Summer in Saturn's northern hemisphere.;
      &p : - Large spike in temperature and presence of ethylene after its dissipation.;
    }
    !div {
      &h3 : "The Day the Earth Smiled";
    }
    !div {
      &h3 class+="bottom-margin" : Cassini Solstice Mission Summary;
      &hr class+="bottom-margin";
      &h3 : Flybys;
      &p : Titan - 43;
      &p : Enceladus - 11;
      &p : Hyperion - 3;
      &p : Dione - 3;
      &p : Rhea - 2;
      &p : Telesto - 2;
      &p : Helene - 1;
      &p : Pallene - 1;
      &p : Methone - 1;
      &p : Epimetheus - 1;
      &p : Prometheus - 1;
      &p class+="bottom-margin" : Aegaeon - 1;
      &h3 : Total - 70;
    }
    !div {
      &h3 class+="bottom-margin" : Final Mission Phase and "The Grand Finale";
      &p class+="bottom-margin" : - Low on propellant.;
      &p class+="bottom-margin" : - 22 high-eccentricity orbits passing between Saturn and its rings.;
      &p class+="bottom-margin" : - Final trajectory would crash Cassini into Saturn.;
    }
    !div {
      &h3 class+="bottom-margin" : Descent Into Saturn;
      &p class+="bottom-margin" : - Data sent in real time as Cassini entered Saturn's atmosphere.;
      &p class+="bottom-margin" : - Valuable information gathered about Saturn's magnetic field.;
      &p class+="bottom-margin" : - Sep 15 2017 6:32 EDT - atmospheric forces angle Cassini's antennae away from Earth leading to loss of signal.;
    }
  }
}

div/images id="images-tab" style="box-sizing: border-box;" {
  !div class+="image-set" {
    &img src="./assets/images/launch-1.jpg" style="max-width: 20rem; max-height: 20rem;";
    &img src="./assets/images/launch-2.jpg" style="max-width: 20rem; max-height: 20rem;";
  }
  !div class+="image-set" {
    &img src="./assets/images/moon.jpg" style="max-width: 20rem; max-height: 20rem;";
  }
  !div class+="image-set" {
    &img src="./assets/images/io-transit.jpg" style="max-width: 15rem; max-height: 15rem;";
    &img src="./assets/images/jupiter-1.jpg" style="max-width: 15rem; max-height: 15rem;";
    &img src="./assets/images/jupiter-2.jpg" style="max-width: 15rem; max-height: 15rem;";
  }
  !div class+="image-set" {
    &img src="./assets/images/saturn-approach.jpg" style="max-width: 20rem; max-height: 20rem;";
  }
  !div class+="image-set" {
    &img src="./assets/images/phoebe.jpg" style="max-width: 40rem; max-height: 20rem;";
  }
  !div class+="image-set-vertical" {
    &div class+="reverse-horizontal-flex" {
      &img src="./assets/images/methone.jpg" style="max-width: 15rem; max-height: 15rem;";
      &img src="./assets/images/methone-discovery.jpg" style="max-width: 15rem; max-height: 15rem;";
    }
    &div class+="reverse-horizontal-flex" {
      &img src="./assets/images/pallene.jpg" style="max-width: 15rem; max-height: 15rem;";
      &img src="./assets/images/pallene-discovery.jpg" style="max-width: 15rem; max-height: 15rem;";
    }
  }
  !div class+="image-set space-between" {
    &img src="./assets/images/titan-map-1.jpg" style="max-width: 40rem; max-height: 14rem;";
    &img src="./assets/images/titan-1.jpg" style="max-width: 20rem; max-height: 20rem;";
  }
  !div class+="image-set" {
    &img src="./assets/images/titan-surface-2.jpg" style="max-width: 15rem; max-height: 20rem;";
    &img src="./assets/images/titan-surface-1.jpg" style="max-width: 40rem; max-height: 20rem;";
  }
  !div class+="image-set" {
    &img src="./assets/images/enceladus-1.jpg" style="max-width: 15rem; max-height: 15rem;";
    &img src="./assets/images/enceladus-2.jpg" style="max-width: 15rem; max-height: 15rem;";
    &img src="./assets/images/enceladus-terrain.jpg" style="max-width: 15rem; max-height: 15rem;";
  }
  !div class+="image-set" {
    &img src="./assets/images/equinox.jpg" style="max-width: 30rem; max-height: 30rem;";
  }
  !div class+="image-set-vertical" {
    &img src="./assets/images/hexagon-seasons.jpg" style="max-width: 30rem; max-height: 30rem;";
    &img src="./assets/images/saturn-solstice.jpg" style="max-width: 30rem; max-height: 15rem;";
  }
  !div class+="image-set' {
    &img src="./assets/images/great-white-spot.jpg" style="max-width: 30rem; max-height: 30rem;";
  }
  !div class+="image-set-vertical" {
    &img src="./assets/images/smile.jpg" style="max-width: 30rem; max-height: 35rem;";
    &img src="./assets/images/smile-earth.jpg" style="max-width: 30rem; max-height: 15rem;";
  }
  !div class+="image-set" {
    &img src="./assets/images/apod.jpg" style="max-width: 30rem; max-height: 30rem;";
  }
  !div class+="image-set-vertical" {
    &img src="./assets/images/impact-site.jpg" style="max-width: 30rem; max-height: 15rem;";
    &img src="./assets/images/final-image.jpg" style="max-width: 15rem; max-height: 25rem;";
  }
}

div id="huygens-descent-video-container" {
  div class+="black-bg";
  video id="huygens-descent-video" src="./assets/videos/huygens-descent.mp4";
}

div/titles {
  !div class+="center black-bg" {
    &h1 class+="center-text" : Pre-launch History;
  }

  !div class+="center black-bg" {
    &h1 class+="center-text" : Saturn's System and Mission Goals;
  }

  !div class+="center black-bg" {
    &h1 class+="center-text" : Instruments;
  }

  !div class+="center black-bg" {
    &h1 class+="center-text" : Mission Timeline;
    &h2 class+="center-text" : Journey to Saturn (Oct 1997 - Jun 2004);
  }

  !div class+="center black-bg" {
    &h1 class+="center-text" : Mission Timeline;
    &h2 class+="center-text" : Initial Mission Phase (Jun 2004 - Jul 2008);
  }

  !div class+="center black-bg" {
    &h1 class+="center-text" : Key Discoveries;
  }

  !div class+="center black-bg" {
    &h1 class+="center-text" : Summary;
  }

  !div class+="center black-bg" {
    &h1 class+="center-text" : Bibliography;
  }
}

frame id="next-saturn-slide" {
  /saturn-system h l;
  saturn-system++;
  saturn-system s i;
}

frame id="next-saturn-text" {
  saturn-system++;
  saturn-system s i;
}

frame id="next-history-text" {
  history h l;
  history++;
  history s i;
}

frame id="next-instrument-text" {
  instruments l;
  instruments++;
  instruments i;
}

frame id="next-timeline-text" {
  timeline h;
  timeline++;
  timeline s;
}

frame id="next-images" {
  images d h;
  images++;
  images i s;
}

frame id="no-images" {
  images d h;
}

frame id="next-title" {
  titles h;
  titles++;
  titles s;
}

frame id="no-title" {
  titles h;
}

frame id="next-key-discoveries" {
  key-discoveries++;
  key-discoveries s;
}

anim initial-frame=1 {
  frame id="reset" {
    /history t h l;
    /saturn-system t h l;
    /instruments t l;
    /timeline t h;
    /images t d h;
    /titles t h;
    /key-discoveries t h;
    id="outline" t h;
    id="overview" t h;
    id="date-tab" t u;
    id="timeline-tab" t r;
    id="images-tab" t h;
    id="huygens-descent-video-container" t h;
    id="summary-container" t h;
    id="blue-bg" t h;
    id="title-image" t s;
  }
  frame {
    id="canvas-container" initializeCanvas("100vw", "100vh") initializeCanvasScene("MODEL");
  }
  frame {
    id="title-image" h;
    id="blue-bg" s;
    id="outline" s;
  }
  frame {
    id="outline" h;
    id="overview" s;
  }
  frame {
    id="overview" h;
    titles s;
  }
  frame {
    frame id="no-title";
    history s i;
  }
  frame amount=4 {
    frame id="next-history-text";
  }
  frame {
    /history l;
    frame id="next-title";
  }
  frame {
    frame id="no-title";
    saturn-system s i;
  }
  frame {
    frame id="next-saturn-text";
  }
  frame {
    frame id="next-saturn-slide";
  }
  frame {
    frame id="next-saturn-text";
  }
  frame {
    frame id="next-saturn-slide";
  }
  frame {
    frame id="next-saturn-text";
  }
  frame {
    frame id="next-saturn-slide";
  }
  frame {
    frame id="next-saturn-text";
  }
  frame {
    frame id="next-saturn-slide";
  }
  frame {
    frame id="next-saturn-text";
  }
  frame {
    /saturn-system l;
    id="blue-bg" h;
    frame id="next-title";
  }
  frame {
    frame id="no-title";
    id="canvas-container" orbitCamera("0.2", "20", "1");
  }
  frame { 
    id="canvas-container" model_unhighlight model_highlightInstrument("HUYGENS") positionCamera("10", "0", "10", "0", "-2", "0", "1"); 
    instruments i;
  }
  frame { 
    id="canvas-container" model_unhighlight model_highlightInstrument("DISH") positionCamera("8", "8", "10", "-2", "5", "0", "1"); 
    frame id="next-instrument-text";
  }
  frame { 
    id="canvas-container" model_unhighlight model_highlightInstrument("RTG") positionCamera("-12", "0", "10", "-2", "-4", "0", "1"); 
    frame id="next-instrument-text";
  }
  frame { 
    id="canvas-container" model_unhighlight model_highlightInstrument("SPECTROMETER") positionCamera("-12", "0", "10", "-2", "0", "0", "1"); 
    frame id="next-instrument-text";
  }
  frame { 
    id="canvas-container" model_unhighlight model_highlightInstrument("MAGNETOMETER") positionCamera("-25", "0", "10", "-10", "0", "0", "1"); 
    frame id="next-instrument-text";
  }
  frame { 
    id="canvas-container" model_unhighlight; 
    instruments l;
  }
  frame id="solar-system" {
    id="canvas-container" initializeCanvasScene("SOLAR") solar_progressOrbit("1", "0.01") halfScreenCanvas;
    frame id="next-title";
  }
  frame {
    frame id="no-title";
    id="date-tab" i;
    id="timeline-tab" i;
    id="images-tab" s;
  }
  frame {
    timeline s;
    images i s;
  }
  frame {
    id="canvas-container" solar_progressOrbit("193", "2");
    frame id="next-timeline-text";
    images d h;
  }
  frame {
    id="canvas-container" solar_progressOrbit("617", "2");
    frame id="next-timeline-text";
  }
  frame {
    id="canvas-container" solar_progressOrbit("672", "2");
    frame id="next-timeline-text";
    frame id="next-images";
  }
  frame {
    id="canvas-container" solar_progressOrbit("1172", "2") positionCamera("0", "2", "0", "0", "0", "0", "5");
    frame id="next-timeline-text";
    frame id="next-images";
  }
  frame {
    id="canvas-container" solar_progressOrbit("2431", "2") positionCamera("0", "4", "0", "0", "0", "0", "5");
    frame id="next-timeline-text";
    frame id="next-images";
  }
  frame id="saturn" {
    id="canvas-container" initializeCanvasScene("SATURN") saturn_progressOrbit("1", "0.01");
    frame id="next-title";
    id="date-tab" u;
    id="images-tab" h;
    id="timeline-tab" r;
  }
  frame {
    frame id="no-title";
    id="date-tab" i;
    id="images-tab" s;
    id="timeline-tab" i;
    frame id="next-timeline-text";
    frame id="next-images";
  }
  frame {
    id="canvas-container" saturn_progressOrbit("20.6", "3");
    frame id="next-timeline-text";
    frame id="no-images";
  }
  frame {
    id="canvas-container" saturn_progressOrbit("66", "1");
    frame id="next-timeline-text";
    frame id="next-images";
  }
  frame {
    id="canvas-container" saturn_progressOrbit("125", "2");
    frame id="no-images";
    timeline h;
  }
  frame {
    id="canvas-container" saturn_progressOrbit("138.1", "3");
    frame id="next-timeline-text";
    frame id="next-images";
  }
  frame {
    id="canvas-container" saturn_progressOrbit("197", "3");
    frame id="next-timeline-text";
    frame id="no-images";
  }
  frame {
    id="canvas-container" saturn_progressOrbit("217", "2");
    frame id="next-timeline-text";
    frame id="next-images";
  }
  frame {
    id="date-tab" h;
    id="timeline-tab" h;
    id="images-tab" h;
    id="huygens-descent-video-container" s;
  }
  frame {
    id="huygens-descent-video" play;
  }
  frame {
    id="date-tab" s;
    id="timeline-tab" s;
    id="images-tab" s;
    id="huygens-descent-video-container" h;
  }
  frame {
    id="canvas-container" saturn_progressOrbit("240", "1");
    frame id="no-images";
    timeline h;
  }
  frame {
    id="canvas-container" saturn_progressOrbit("251.5", "2") positionCamera("0", "2", "-1", "0", "0", "0", "1");
    frame id="next-timeline-text";
    frame id="next-images";
  }
  frame {
    id="canvas-container" saturn_progressOrbit("1458", "3") positionCamera("0", "2", "-2", "0", "0", "0", "1");
    frame id="next-timeline-text";
    frame id="no-images";
  }
  frame {
    frame id="next-timeline-text";
    frame id="next-images";
  }
  frame {
    id="canvas-container" saturn_progressOrbit("2273", "3");
    frame id="next-timeline-text";
    frame id="no-images";
  }
  frame {
    frame id="next-timeline-text";
    frame id="next-images";
  }
  frame {
    id="canvas-container" saturn_progressOrbit("2368", "3");
    frame id="next-timeline-text";
    frame id="next-images";
  }
  frame {
    id="canvas-container" saturn_progressOrbit("3325", "3");
    frame id="next-timeline-text";
    frame id="next-images";
  }
  frame {
    frame id="next-timeline-text";
    frame id="no-images";
  }
  frame {
    id="canvas-container" saturn_progressOrbit("4698", "3");
    frame id="next-timeline-text";
    frame id="next-images";
  }
  frame {
    id="canvas-container" saturn_progressOrbit("4845", "15") positionCamera("-0.5", "1", "-1", "0", "0", "0", "10");
    frame id="next-timeline-text";
    frame id="next-images";
  }
  frame {
    id="date-tab" u h;
    id="timeline-tab" r h;
    id="images-tab" d h;
    frame id="next-title";
  }
  frame {
    frame id="no-title";
    id="blue-bg" s;
    id="summary-container" s i;
    key-discoveries s;
  }
  frame amount="7" {
    frame id="next-key-discoveries";
  }
}